function esFeriado(d){ return FERIADOS.includes(d.toISOString().split('T')[0]); }
function diasHab(iStr, fStr){
  let start = new Date(iStr), end = new Date(fStr), habs = 0, fin = 0, fer = 0;
  while(start <= end){
    const d = new Date(start.getTime() + Math.abs(start.getTimezoneOffset()*60000));
    const day = d.getUTCDay();
    if(day===0 || day===6) fin++; else if(esFeriado(d)) fer++; else habs++;
    start.setDate(start.getDate()+1);
  }
  return {habs, fer, fin};
}
function previewVac() {
  const tid = $("vac-trab").value, iStr = $("vac-ini").value, fStr = $("vac-fin").value;
  if(!tid){ ["base","usados","saldo","descontar","finde","feriados","final"].forEach(x => $("vac-r-"+x).textContent="0"); return; }
  const t = DB.trab.find(x=>String(x.id)===String(tid));
  const base = 15, usados = DB.vacs.filter(x=>String(x.trabajadorId)===tid && x.estado==='Aprobada').reduce((a,b)=>a+(b.dias||0),0);
  $("vac-r-base").textContent = base; $("vac-r-usados").textContent = usados; $("vac-r-saldo").textContent = base-usados;
  let habs = 0, fer = 0, fin = 0;
  if(iStr && fStr && new Date(fStr)>=new Date(iStr)) { const r = diasHab(iStr, fStr); habs = r.habs; fer = r.fer; fin = r.fin; }
  $("vac-r-descontar").textContent = habs; $("vac-r-finde").textContent = fin; $("vac-r-feriados").textContent = fer;
  $("vac-r-final").textContent = (base-usados) - habs;
}
