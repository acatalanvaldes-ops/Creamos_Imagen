<script>
/* =========================================================================
   1. CONSTANTES, ESTADO GLOBAL Y SINCRONIZACIÓN NUBE
========================================================================= */
const API_URL = "https://script.google.com/macros/s/AKfycbxP5-vB59e80qpXdx4AcCyS28C4H58thdh0XXtLcDWZD8Q_47fDbBvLn1ahqx7RoJor/exec";
const CLOUD_TOKEN = "b5bd161b4ef581c6114b7bb4";

const CONFIG_PREV = {
  AFP_OBLIGATORIA: 10, SALUD: 7, AFC_TRABAJADOR: 0.6,
  COMISIONES: { UNO: 0.46, MODELO: 0.58, PLANVITAL: 1.16, HABITAT: 1.27, CAPITAL: 1.44, CUPRUM: 1.44, PROVIDA: 1.45 }
};
const FERIADOS = ["2026-01-01","2026-04-03","2026-05-01","2026-05-21","2026-06-29","2026-07-16","2026-08-15","2026-09-18","2026-09-19","2026-10-12","2026-10-31","2026-11-01","2026-12-08","2026-12-25"];

const DB = {
  trab: [], docs: [], asis: [], vacs: [], liqs: [], fins: [], prev: [], libros: []
};
const KEYS = {
  trab: "rrhh_trabajadores_v1", docs: "rrhh_documentos_v1", asis: "rrhh_asistencia_v1",
  vacs: "rrhh_vacaciones_v1", liqs: "rrhh_liquidaciones_v1", fins: "rrhh_finiquitos_v1",
  prev: "rrhh_previred_v1", libros: "rrhh_libro_rem_v1"
};

const $ = id => document.getElementById(id);
function fmt(v){ return "$" + Math.round(Number(v||0)).toLocaleString("es-CL"); }
function fmtDate(iso){ if(!iso) return '-'; const [y,m,d] = iso.split('-'); return `${d}/${m}/${y}`; }
function genId(){ return Date.now() + Math.floor(Math.random()*1000); }

// El backend (Google Apps Script) a veces devuelve una falla transitoria
// -una página de error en vez de JSON, un HTTP no-OK, o una respuesta muy
// lenta que se queda colgada- que se resuelve sola al reintentar. Sin
// reintentos ni un tope de tiempo por intento, una falla pasajera se veía
// como "no hay datos" y la página podía quedarse esperando varios minutos.
function esperar(ms) { return new Promise(function (r) { setTimeout(r, ms); }); }
const CLOUD_INTENTOS = 3;
const CLOUD_TIMEOUT_MS = 12000;

async function fetchConTimeout(url, opts) {
  const controller = new AbortController();
  const timer = setTimeout(function () { controller.abort(); }, CLOUD_TIMEOUT_MS);
  try {
    return await fetch(url, Object.assign({}, opts, { signal: controller.signal }));
  } finally {
    clearTimeout(timer);
  }
}

// Lee una llave cruda de la nube (sin desarmar particiones), con reintentos.
// Lanza una excepción si los 3 intentos fallan, en vez de devolver un valor
// vacío silenciosamente -eso es justo lo que causó pérdida real de datos en
// el módulo de Clientes: una carga fallida se confundía con "no hay nada".
async function fetchClaveNube(key) {
  const url = API_URL + "?key=" + key + "&token=" + CLOUD_TOKEN;
  let ultimoError;
  for (let intento = 0; intento < CLOUD_INTENTOS; intento++) {
    try {
      const res = await fetchConTimeout(url);
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const json = await res.json();
      return json.valor ? JSON.parse(json.valor) : null;
    } catch (e) {
      ultimoError = e;
      if (intento < CLOUD_INTENTOS - 1) await esperar(500 * (intento + 1));
    }
  }
  throw ultimoError;
}

async function saveCloudRaw(key, dataObj) {
  let ultimoError;
  for (let intento = 0; intento < CLOUD_INTENTOS; intento++) {
    try {
      const res = await fetchConTimeout(API_URL, { method: 'POST', body: JSON.stringify({ key: key, value: JSON.stringify(dataObj), token: CLOUD_TOKEN }) });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      return true;
    } catch (e) {
      ultimoError = e;
      if (intento < CLOUD_INTENTOS - 1) await esperar(500 * (intento + 1));
    }
  }
  console.error('Error guardando en la nube', key, ultimoError);
  return false;
}

// Una sola celda de Google Sheets no admite más de 50.000 caracteres. Los
// documentos del módulo (contratos, carnet, certificados) se guardan como
// texto base64, y un solo archivo normal (una foto de carnet, un PDF
// escaneado) puede tener cientos de miles de caracteres -muy por sobre ese
// límite. MAX_SHARD_CHARS reparte el JSON completo de cada módulo en
// bloques de ese tamaño, cada uno en su propia celda ("<llave>_sh1",
// "<llave>_sh2", etc.), y los vuelve a unir al leer. A diferencia del
// particionado por registro completo que usan otros módulos (Calendario,
// Ventas), acá se parte el texto en cualquier punto, porque un solo
// documento adjunto ya puede superar el límite por sí solo.
const MAX_SHARD_CHARS = 40000;

function partirTexto(texto, maxChars) {
  const partes = [];
  for (let i = 0; i < texto.length; i += maxChars) partes.push(texto.slice(i, i + maxChars));
  return partes.length ? partes : [''];
}

async function saveCloudSharded(key, dataArray) {
  const json = JSON.stringify(dataArray);
  const partes = partirTexto(json, MAX_SHARD_CHARS);
  const okPrincipal = await saveCloudRaw(key, { shardCount: partes.length, parte: partes[0] });
  let okResto = true;
  for (let i = 1; i < partes.length; i++) {
    const ok = await saveCloudRaw(key + '_sh' + i, { parte: partes[i] });
    if (!ok) okResto = false;
  }
  return okPrincipal && okResto;
}

async function loadCloudSharded(key) {
  const principal = await fetchClaveNube(key);
  if (principal === null || principal === undefined) return []; // la llave nunca se ha creado: vacío legítimo, no es una falla.
  if (Array.isArray(principal)) return principal; // dato guardado antes de este particionado.
  if (principal && typeof principal.shardCount === 'number' && typeof principal.parte === 'string') {
    let texto = principal.parte;
    for (let i = 1; i < principal.shardCount; i++) {
      const bloque = await fetchClaveNube(key + '_sh' + i);
      if (!bloque || typeof bloque.parte !== 'string') throw new Error('Falta el bloque ' + i + ' de ' + key);
      texto += bloque.parte;
    }
    return JSON.parse(texto);
  }
  // Forma de dato no reconocida: se trata como una falla de carga (no se
  // asume que está vacío), para no arriesgar sobrescribir datos reales.
  throw new Error('Formato de datos no reconocido para ' + key);
}

// Por cada uno de los 8 tipos de datos de RR.HH. se recuerda si la carga
// inicial desde la nube se confirmó o no. Mientras no se confirme, los
// guardados de ESE tipo en particular se hacen solo en este computador (no
// se suben a la nube), para no arriesgar sobrescribir datos reales de
// sueldos y trabajadores con datos incompletos -el mismo problema que ya
// causó pérdida real de clientes en el módulo de Clientes.
const cargaOk = { trab:false, docs:false, asis:false, vacs:false, liqs:false, fins:false, prev:false, libros:false };

function saveData(moduleKey, dataArray) {
  localStorage.setItem(KEYS[moduleKey], JSON.stringify(dataArray));
  if (!cargaOk[moduleKey]) {
    alert('No se pudo confirmar la conexión con la nube al abrir esta página para esta sección de Recursos Humanos. Para no perder información ya guardada, recarga la página (F5) antes de seguir agregando o editando datos aquí.');
    return;
  }
  saveCloudSharded(KEYS[moduleKey], dataArray);
}

// =========================================================================
// 2. INICIALIZACIÓN Y NAVEGACIÓN
// =========================================================================
window.onload = async function() {
  // Carga Local Inicial: se ve algo de inmediato aunque la nube esté lenta.
  Object.keys(KEYS).forEach(k => { try { const d = localStorage.getItem(KEYS[k]); if(d) DB[k] = JSON.parse(d); } catch(e){} });

  // Setear defaults UI
  $("rep-periodo").value = new Date().toISOString().slice(0,7);
  $("liq-periodo").value = new Date().toISOString().slice(0,7);
  $("prev-periodo").value = new Date().toISOString().slice(0,7);
  $("lib-periodo").value = new Date().toISOString().slice(0,7);

  actualizarSelectsTrabajadores();
  renderActiveTab();

  // Carga real desde la nube: las 8 llaves en paralelo (no una por una, que
  // es lo que hacía sentir lenta la carga de Clientes), cada una con
  // reintentos y tope de tiempo. Si alguna falla tras los 3 intentos, esa
  // sección en particular queda marcada como no confirmada (cargaOk) y sus
  // guardados posteriores no suben a la nube hasta recargar la página.
  const nombresClaves = Object.keys(KEYS);
  const resultados = await Promise.allSettled(nombresClaves.map(function (k) {
    return loadCloudSharded(KEYS[k]).then(function (cloud) { return { k: k, cloud: cloud }; });
  }));

  let huboFallas = false;
  resultados.forEach(function (r, idx) {
    const k = nombresClaves[idx];
    if (r.status === 'fulfilled') {
      DB[k] = r.value.cloud || [];
      localStorage.setItem(KEYS[k], JSON.stringify(DB[k]));
      cargaOk[k] = true;
    } else {
      console.error('Error cargando', KEYS[k], r.reason);
      cargaOk[k] = false;
      huboFallas = true;
    }
  });
  if (huboFallas) {
    alert('No se pudo confirmar la conexión con la nube para algunos datos de Recursos Humanos. Se están mostrando los últimos datos guardados en este computador. Recarga la página (F5) antes de agregar o editar información, para evitar duplicados o pérdidas de datos.');
  }

  actualizarSelectsTrabajadores();
  renderActiveTab();
};

let activeTab = 'trabajadores';
function showTab(name, btn) {
  document.querySelectorAll('.ttab').forEach(b => b.classList.remove('on'));
  btn.classList.add('on');
  document.querySelectorAll('.panel').forEach(p => p.classList.remove('on'));
  $('p-' + name).classList.add('on');
  activeTab = name;
  renderActiveTab();
}

function renderActiveTab() {
  if(activeTab === 'trabajadores') renderTrabajadores();
  if(activeTab === 'documentos') renderDocumentos();
  if(activeTab === 'asistencia') renderAsistencia();
  if(activeTab === 'vacaciones') renderVacaciones();
  if(activeTab === 'liquidaciones') renderLiquidaciones();
  if(activeTab === 'finiquitos') renderFiniquitos();
  if(activeTab === 'previred') renderPrevired();
  if(activeTab === 'libro') renderLibros();
  if(activeTab === 'reportes') renderReportes();
}

function getNombreTrabajador(id) {
  const t = DB.trab.find(x => String(x.id) === String(id));
  return t ? `${t.nombres} ${t.apellidos}` : '(Eliminado)';
}
function actualizarSelectsTrabajadores() {
  const ordenados = DB.trab.slice().sort((a,b) => (a.nombres||'').localeCompare(b.nombres||''));
