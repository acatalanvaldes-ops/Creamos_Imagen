let liqActual = null;
function resetLiqCalc() { liqActual = null; $("btnGuardaLiq").disabled = true; ['imp','noimp','afpname','afp','salud','afc','liq'].forEach(x => $("liq-r-"+x).textContent = (x==='afpname'?'':'$0')); }
function calcularLiq() {
  const tid = $("liq-trab").value, per = $("liq-periodo").value;
  if(!tid || !per){ alert("Trabajador y Período requeridos"); return; }
  const t = DB.trab.find(x=>String(x.id)===String(tid)); if(!t) return;
  const sb = Number($("liq-sb").value)||0, gr = Number($("liq-grat").value)||0, bo = Number($("liq-bonos").value)||0, co = Number($("liq-com").value)||0, col = Number($("liq-col").value)||0, mov = Number($("liq-mov").value)||0;
  const hrsEx = DB.asis.filter(a=>String(a.trabajadorId)===tid && (a.fecha||"").startsWith(per)).reduce((s,a)=>s+Number(a.horasExtras||0),0);
  const mEx = hrsEx * (sb/180) * 1.5;
  const imp = sb + gr + bo + co + mEx;
  const noimp = col + mov;
  const afpName = (t.afp || 'MODELO').toUpperCase();
  const comPct = CONFIG_PREV.COMISIONES[afpName] || 0.58;
  const vAfp = imp * (CONFIG_PREV.AFP_OBLIGATORIA/100);
  const vCom = imp * (comPct/100);
  const vSalud = imp * (CONFIG_PREV.SALUD/100);
  const vAfc = imp * (CONFIG_PREV.AFC_TRABAJADOR/100);
  const desc = vAfp + vCom + vSalud + vAfc;
  const liq = (imp + noimp) - desc;

  liqActual = { trabajadorId:tid, periodo:per, sueldoBase:sb, gratificacion:gr, bonos:bo, comisiones:co, colacion:col, movilizacion:mov, montoHorasExtras:mEx, imponible:imp, totalHaberesNoImp:noimp, afpName, porcentajeComision:comPct, afp:vAfp, comisionAFP:vCom, salud:vSalud, afc:vAfc, totalDescuentos:desc, liquido:liq, fechaGeneracion:new Date().toISOString() };

  $("liq-r-imp").textContent = fmt(imp); $("liq-r-noimp").textContent = fmt(noimp);
  $("liq-r-afpname").textContent = afpName; $("liq-r-afp").textContent = fmt(vAfp+vCom);
  $("liq-r-salud").textContent = fmt(vSalud); $("liq-r-afc").textContent = fmt(vAfc);
  $("liq-r-liq").textContent = fmt(liq);
  $("btnGuardaLiq").disabled = false;
}
function guardarLiq() {
  if(!liqActual) return;
  const idx = DB.liqs.findIndex(x=>String(x.trabajadorId)===String(liqActual.trabajadorId) && x.periodo===liqActual.periodo);
  if(idx!==-1) { if(!confirm("Ya existe liquidación en este período. ¿Sobreescribir?")) return; DB.liqs[idx] = {id: DB.liqs[idx].id, ...liqActual}; }
  else { DB.liqs.push({id: genId(), estado:'GENERADA', ...liqActual}); }
  saveData('liqs', DB.liqs); ['sb','grat','bonos','com','col','mov'].forEach(x=>$("liq-"+x).value=""); resetLiqCalc(); renderLiquidaciones();
}
function elimLiq(id){ if(confirm("¿Eliminar?")){ DB.liqs = DB.liqs.filter(x=>x.id!==id); saveData('liqs', DB.liqs); renderLiquidaciones(); } }
