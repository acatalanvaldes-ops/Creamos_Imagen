  if(!tid || !fTerm){ alert("Seleccione trabajador y fecha de término"); return; }
  const t = DB.trab.find(x=>String(x.id)===String(tid)); if(!t) return;
  const liqs = DB.liqs.filter(x=>String(x.trabajadorId)===String(tid)).sort((a,b)=>new Date(b.fechaGeneracion)-new Date(a.fechaGeneracion));
  if(!liqs.length){ alert("El trabajador debe tener al menos 1 liquidación para extraer el sueldo base."); return; }
  const sImp = Number(liqs[0].imponible)||0;

  const fIng = t.fechaIngreso ? new Date(t.fechaIngreso) : new Date(fTerm);
  const dT = new Date(fTerm);
  let anios = dT.getFullYear() - fIng.getFullYear();
  let meses = dT.getMonth() - fIng.getMonth();
  if(meses<0){ anios--; meses+=12; }
  if(dT.getDate() < fIng.getDate()) meses--;
  if(meses<0){ anios--; meses+=12; }
  if(meses>=6) anios++;
  if(anios>11) anios = 11;
  anios = Math.max(0, anios);

  const causal = $("fin-causal").value;
  let ias = 0, aviso = 0;
  if(causal === "161"){ ias = sImp * anios; if($("fin-aviso").value === "NO") aviso = sImp; }

  const totVac = Number($("fin-vac").value)||0;
  const valVac = (sImp/30) * totVac;
  const total = ias + aviso + valVac;

  finActual = { trabajadorId:tid, fechaTermino:fTerm, causal, sueldoBaseImponible:sImp, aniosReconocidos:anios, ias, aviso, vacTotales:totVac, valorVacaciones:valVac, total };

  $("fin-r-ias").textContent = fmt(ias); $("fin-r-aviso").textContent = fmt(aviso); $("fin-r-vac").textContent = fmt(valVac); $("fin-r-tot").textContent = fmt(total);
  $("btnGuardaFin").disabled = false;
}
function guardarFin() {
  if(!finActual) return;
  const idx = DB.fins.findIndex(x=>String(x.trabajadorId)===String(finActual.trabajadorId));
  if(idx!==-1) { if(!confirm("Ya existe un finiquito. ¿Sobreescribir?")) return; DB.fins[idx] = {id: DB.fins[idx].id, estado:'GENERADO', ...finActual}; }
  else { DB.fins.push({id: genId(), estado:'GENERADO', ...finActual}); }
  saveData('fins', DB.fins); resetFinCalc(); $("fin-fecha").value=""; $("fin-vac").value=""; renderFiniquitos();
}
function elimFin(id){ if(confirm("¿Eliminar?")){ DB.fins = DB.fins.filter(x=>x.id!==id); saveData('fins', DB.fins); renderFiniquitos(); } }
function printFin(id){
  const f = DB.fins.find(x=>x.id===id); if(!f) return;
  const t = DB.trab.find(x=>String(x.id)===String(f.trabajadorId));
  const v = window.open("","_blank");
  v.document.write(`<html><body style="font-family:sans-serif;padding:40px;line-height:1.5"><h2>FINIQUITO CONTRATO DE TRABAJO</h2><p>Trabajador: ${t?t.nombres+' '+t.apellidos:'-'}</p><p>RUT: ${t?t.rut:'-'}</p><p>Término: ${fmtDate(f.fechaTermino)}</p><p>Causal: Art. ${f.causal}</p><hr><p>IAS (${f.aniosReconocidos} años): ${fmt(f.ias)}</p><p>Aviso Previo: ${fmt(f.aviso)}</p><p>Vacaciones: ${fmt(f.valorVacaciones)}</p><hr><h3>TOTAL A PAGAR: ${fmt(f.total)}</h3></body></html>`);
  v.document.close(); setTimeout(()=>v.print(), 250);
}
function renderFiniquitos() {
  $("kpi-fin-tot").textContent = DB.fins.length;
  $("kpi-fin-pago").textContent = fmt(DB.fins.reduce((a,b)=>a+(b.total||0),0));
  const q = $("buscarFin").value.toLowerCase();
  const arr = DB.fins.filter(x=>getNombreTrabajador(x.trabajadorId).toLowerCase().includes(q)).sort((a,b)=>new Date(b.fechaTermino)-new Date(a.fechaTermino));
  $("tablaFin").innerHTML = arr.length ? arr.map(f => `<tr><td style="font-family:var(--mono)">${fmtDate(f.fechaTermino)}</td><td style="font-weight:700">${getNombreTrabajador(f.trabajadorId)}</td><td>Art. ${f.causal}</td><td style="font-weight:800;color:var(--teal);text-align:right">${fmt(f.total)}</td><td style="text-align:right"><button class="act-btn small" onclick="printFin(${f.id})">🖨️</button><button class="act-btn small" style="color:var(--red);border-color:#FECACA;margin-left:4px" onclick="elimFin(${f.id})">🗑️</button></td></tr>`).join('') : `<tr><td colspan="5" style="text-align:center;padding:20px;color:var(--muted)">Sin resultados</td></tr>`;
}

// =========================================================================
// 9. PREVIRED
// =========================================================================
let prevActual = null;
function resetPrevCalc() { prevActual = null; $("prevResumen").style.display = "none"; }
function generarPrevired() {
  const per = $("prev-periodo").value; if(!per){ alert("Seleccione período"); return; }
  const liqs = DB.liqs.filter(l => l.periodo === per);
  if(!liqs.length){ alert("No hay liquidaciones en este período."); return; }
  const regs = liqs.map(l => {
    const t = DB.trab.find(x=>String(x.id)===String(l.trabajadorId));
    const afpNombre = t ? (t.afp||'MODELO').toUpperCase() : 'MODELO';
    const comPct = CONFIG_PREV.COMISIONES[afpNombre] || 0.58;
    const imp = Number(l.imponible)||0;
    const afp = imp*(CONFIG_PREV.AFP_OBLIGATORIA/100);
    const com = imp*(comPct/100);
    const sal = imp*(CONFIG_PREV.SALUD/100);
    const afc = imp*(CONFIG_PREV.AFC_TRABAJADOR/100);
    return { trabajadorId:l.trabajadorId, rut:t?t.rut:'S/R', nombre:t?`${t.nombres} ${t.apellidos}`:'-', afpNombre, imponible:imp, afp, comisionAFP:com, salud:sal, afc, total:afp+com+sal+afc };
  });
  prevActual = { periodo:per, registros:regs, totAfp:regs.reduce((a,b)=>a+b.afp,0), totCom:regs.reduce((a,b)=>a+b.comisionAFP,0), totSalud:regs.reduce((a,b)=>a+b.salud,0), totAfc:regs.reduce((a,b)=>a+b.afc,0), totGen:regs.reduce((a,b)=>a+b.total,0) };

  $("prev-r-per").textContent = per; $("prev-r-trab").textContent = regs.length + " trabajadores";
  $("prev-r-afp").textContent = fmt(prevActual.totAfp + prevActual.totCom); $("prev-r-salud").textContent = fmt(prevActual.totSalud);
  $("prev-r-afc").textContent = fmt(prevActual.totAfc); $("prev-r-tot").textContent = fmt(prevActual.totGen);
  $("tablaPrevDetalle").innerHTML = regs.map(r=>`<tr><td>${r.rut}</td><td>${r.nombre}</td><td>${r.afpNombre}</td><td style="text-align:right">${fmt(r.imponible)}</td><td style="text-align:right">${fmt(r.afp+r.comisionAFP)}</td><td style="text-align:right">${fmt(r.salud)}</td><td style="text-align:right">${fmt(r.afc)}</td><td style="text-align:right;font-weight:bold">${fmt(r.total)}</td></tr>`).join('');
  $("prevResumen").style.display = "block";
}
function guardarPrevired() {
  if(!prevActual) return;
  const idx = DB.prev.findIndex(n => n.periodo === prevActual.periodo);
  if(idx!==-1){ if(!confirm("Ya existe. ¿Sobreescribir?")) return; DB.prev[idx] = {id: DB.prev[idx].id, ...prevActual}; }
  else { DB.prev.push({id: genId(), ...prevActual}); }
  saveData('prev', DB.prev); renderPrevired();
}
function exportarCSVPrevired() {
  if(!prevActual) return;
  let csv = "RUT;Nombre;AFP;Imponible;AFP+Comision;Salud;AFC;Total a Pagar\n";
  prevActual.registros.forEach(r => { csv += `${r.rut.replace(/\./g,"")};${r.nombre};${r.afpNombre};${Math.round(r.imponible)};${Math.round(r.afp+r.comisionAFP)};${Math.round(r.salud)};${Math.round(r.afc)};${Math.round(r.total)}\n`; });
  const a = document.createElement("a"); a.href = URL.createObjectURL(new Blob([csv], {type:'text/csv'})); a.download = `Previred_${prevActual.periodo}.csv`; document.body.appendChild(a); a.click(); document.body.removeChild(a);
}
function elimPrev(id){ if(confirm("¿Eliminar?")){ DB.prev = DB.prev.filter(x=>x.id!==id); saveData('prev', DB.prev); renderPrevired(); } }
function renderPrevired() {
  $("kpi-prev-nom").textContent = DB.prev.length;
  $("kpi-prev-tot").textContent = fmt(DB.prev.reduce((a,b)=>a+(b.totGen||0),0));
  const arr = DB.prev.slice().sort((a,b)=>b.periodo.localeCompare(a.periodo));
  $("tablaPrev").innerHTML = arr.length ? arr.map(n => `<tr><td style="font-family:var(--mono);font-weight:700">${n.periodo}</td><td style="text-align:center">${n.registros.length}</td><td style="text-align:right;color:var(--teal);font-weight:bold">${fmt(n.totGen)}</td><td style="text-align:right"><button class="act-btn small" style="color:var(--red);border-color:#FECACA" onclick="elimPrev(${n.id})">🗑️</button></td></tr>`).join('') : `<tr><td colspan="4" style="text-align:center;padding:20px;color:var(--muted)">Sin resultados</td></tr>`;
}

// =========================================================================
// 10. LIBRO DE REMUNERACIONES
// =========================================================================
let libActual = null;
function resetLibCalc() { libActual = null; $("libResumen").style.display = "none"; $("libErrores").style.display = "none"; }
function generarLibro() {
  const per = $("lib-periodo").value; if(!per){ alert("Seleccione período"); return; }
  const liqs = DB.liqs.filter(l => l.periodo === per);
  if(!liqs.length){ $("libErrores").innerHTML = "No existen liquidaciones en este período."; $("libErrores").style.display="block"; return; }
  const errs = []; const procesados = new Set();
  liqs.forEach(r => { if(procesados.has(r.trabajadorId)) errs.push(`Trabajador duplicado: ${getNombreTrabajador(r.trabajadorId)}`); else procesados.add(r.trabajadorId); });
  if(errs.length){ $("libErrores").innerHTML = "Errores:<br>" + errs.join("<br>"); $("libErrores").style.display="block"; return; }
  $("libErrores").style.display="none";

  const imp = liqs.reduce((a,b)=>a+Number(b.imponible),0);
  const desc = liqs.reduce((a,b)=>a+Number(b.totalDescuentos),0);
  const liq = liqs.reduce((a,b)=>a+Number(b.liquido),0);

  libActual = { periodo:per, estado: $("lib-estado").value, numTrab: liqs.length, imponible: imp, descuentos: desc, liquido: liq, registros: liqs };
  $("lib-r-per").textContent = per; $("lib-r-trab").textContent = liqs.length; $("lib-r-imp").textContent = fmt(imp); $("lib-r-desc").textContent = fmt(desc); $("lib-r-liq").textContent = fmt(liq);
  $("libResumen").style.display = "block";
}
function guardarLibro() {
  if(!libActual) return;
  const idx = DB.libros.findIndex(l => l.periodo === libActual.periodo);
  if(idx!==-1){ if(!confirm("Ya existe. ¿Sobreescribir?")) return; DB.libros[idx] = {id: DB.libros[idx].id, ...libActual}; }
  else { DB.libros.push({id: genId(), ...libActual}); }
  saveData('libros', DB.libros); resetLibCalc(); renderLibros();
}
function elimLib(id){ if(confirm("¿Eliminar Libro?")){ DB.libros = DB.libros.filter(x=>x.id!==id); saveData('libros', DB.libros); renderLibros(); } }
async function dlLibroExcel(id) {
  const l = DB.libros.find(x=>x.id===id); if(!l) return;
  const wb = new ExcelJS.Workbook(); const ws = wb.addWorksheet(`Libro_${l.periodo}`);
  ws.columns = [ {header:'RUT', key:'rut', width:15}, {header:'Nombre', key:'nom', width:30}, {header:'Imponible', key:'imp', width:15}, {header:'Descuentos', key:'desc', width:15}, {header:'Líquido', key:'liq', width:15} ];
  l.registros.forEach(r => { const t = DB.trab.find(x=>String(x.id)===String(r.trabajadorId)); ws.addRow({ rut:t?t.rut:'-', nom:t?`${t.nombres} ${t.apellidos}`:'-', imp:r.imponible||0, desc:r.totalDescuentos||0, liq:r.liquido||0 }); });
  const buf = await wb.xlsx.writeBuffer(); const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([buf])); a.download = `Libro_Remuneraciones_${l.periodo}.xlsx`; document.body.appendChild(a); a.click(); document.body.removeChild(a);
}
function renderLibros() {
  $("kpi-lib-tot").textContent = DB.libros.length;
  const arr = DB.libros.slice().sort((a,b)=>b.periodo.localeCompare(a.periodo));
  $("tablaLibros").innerHTML = arr.length ? arr.map(l => `<tr><td style="font-family:var(--mono);font-weight:700">${l.periodo}</td><td style="text-align:center">${l.numTrab}</td><td style="text-align:right;font-weight:bold;color:var(--teal)">${fmt(l.liquido)}</td><td style="text-align:center"><span class="badge ${l.estado==='Cerrado'?'badge-ok':'badge-warn'}">${l.estado}</span></td><td style="text-align:right;white-space:nowrap"><button class="act-btn small" onclick="dlLibroExcel(${l.id})">⬇ Excel</button><button class="act-btn small" style="color:var(--red);border-color:#FECACA;margin-left:4px" onclick="elimLib(${l.id})">🗑️</button></td></tr>`).join('') : `<tr><td colspan="5" style="text-align:center;padding:20px;color:var(--muted)">Sin resultados</td></tr>`;
}

// =========================================================================
// 11. REPORTES GERENCIALES
// =========================================================================
let charts = { dot: null, costo: null, lic: null, hrs: null };
function destroyCharts(){ Object.keys(charts).forEach(k => { if(charts[k]) charts[k].destroy(); }); }
function renderReportes() {
  const per = $("rep-periodo").value; const areaF = $("rep-area").value;
  const trabs = DB.trab.filter(t => (t.estado==='Activo'||!t.estado) && (!areaF || t.area===areaF));
  const tidSet = new Set(trabs.map(t=>String(t.id)));

  // KPIs
  $("rep-kpi-dot").textContent = trabs.length;
  const liqs = DB.liqs.filter(l => l.periodo===per && tidSet.has(String(l.trabajadorId)));
  $("rep-kpi-costo").textContent = fmt(liqs.reduce((a,b)=>a+(b.imponible*1.048)+(b.totalHaberesNoImp||0),0));
  const asis = DB.asis.filter(a => (a.fecha||"").startsWith(per) && tidSet.has(String(a.trabajadorId)));
  $("rep-kpi-hrs").textContent = asis.reduce((a,b)=>a+(b.horasExtras||0),0).toFixed(1);
  const lics = DB.lics ? DB.lics.filter(l => ((l.fechaInicio||"").startsWith(per)||(l.fechaFin||"").startsWith(per)) && tidSet.has(String(l.trabajadorId))) : []; // Evitar fallo si no hay mod licencias en este html
  const dLic = lics.reduce((a,b)=>a+(b.dias||0),0);
  $("rep-kpi-aus").textContent = (trabs.length*30 > 0 ? ((dLic/(trabs.length*30))*100).toFixed(1) : 0) + "%";

  // Áreas Select
  if(!areaF){
    const as = new Set(); DB.trab.forEach(t=>{ if(t.area && t.estado!=='Inactivo') as.add(t.area.trim()); });
    const sel = $("rep-area"); sel.innerHTML = '<option value="">Todas</option>' + [...as].sort().map(a=>`<option value="${a}">${a}</option>`).join('');
  }

  destroyCharts();

  // Dotacion
  const countsDot = {}; trabs.forEach(t=>{ const a = t.area||"Sin Área"; countsDot[a] = (countsDot[a]||0)+1; });
  charts.dot = new Chart($("chartDot").getContext('2d'), { type:'doughnut', data:{ labels:Object.keys(countsDot), datasets:[{data:Object.values(countsDot), backgroundColor:['#0D7A6B','#C8973A','#1E40AF','#C0392B','#6D28D9']}] }, options:{responsive:true,maintainAspectRatio:false} });

  // Costos
  let tImp=0, tDesc=0, tLiq=0; liqs.forEach(l=>{ tImp+=Number(l.imponible||0); tDesc+=Number(l.totalDescuentos||0); tLiq+=Number(l.liquido||0); });
  charts.costo = new Chart($("chartCosto").getContext('2d'), { type:'bar', data:{ labels:['Imponible','Descuentos','Líquido'], datasets:[{label:'Monto ($)', data:[tImp,tDesc,tLiq], backgroundColor:['#1E40AF','#C0392B','#0D7A6B']}] }, options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}}} });

  // Ausentismo
  const countsLic = {}; lics.forEach(l=>{ const t = l.tipo||"Otro"; countsLic[t] = (countsLic[t]||0)+Number(l.dias||0); });
  if(Object.keys(countsLic).length) {
    charts.lic = new Chart($("chartLic").getContext('2d'), { type:'pie', data:{ labels:Object.keys(countsLic), datasets:[{data:Object.values(countsLic), backgroundColor:['#C0392B','#B45309','#78716C']}] }, options:{responsive:true,maintainAspectRatio:false} });
  }

  // Horas Extras
  const countsHrs = {}; asis.forEach(a=>{ const t = trabs.find(x=>String(x.id)===String(a.trabajadorId)); if(t && a.horasExtras>0){ const ar = t.area||"Sin Área"; countsHrs[ar] = (countsHrs[ar]||0)+a.horasExtras; } });
  charts.hrs = new Chart($("chartHrs").getContext('2d'), { type:'bar', data:{ labels:Object.keys(countsHrs), datasets:[{label:'Horas Extras', data:Object.values(countsHrs), backgroundColor:'#C8973A'}] }, options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}}} });
}

