<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Recursos Humanos - Creamos Imagen</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<!-- Librerías Externas -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.4.0/exceljs.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
:root{--bg:#F7F5F0;--surface:#FFFFFF;--dark:#1C1917;--gold:#C8973A;--teal:#0D7A6B;--red:#C0392B;--muted:#78716C;--border:#E7E2D9;--purple:#6D28D9;--blue:#1E40AF;--green:#166534;--amber:#B45309}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--dark);min-height:100vh}
input,select,button,textarea{font-family:inherit;outline:none}
.topbar{background:var(--dark);padding:0 24px;display:flex;align-items:center;flex-wrap:wrap;gap:8px;position:sticky;top:0;z-index:100;height:56px;}
.brand{display:flex;flex-direction:column;justify-content:center;margin-right:24px;margin-left:90px;}
.brand-tag{font-size:8px;color:var(--gold);letter-spacing:.2em;font-weight:700;text-transform:uppercase;}
.brand-name{font-family:'DM Serif Display',serif;font-size:20px;color:#fff;line-height:1.1}
.brand-name span{color:var(--gold)}

/* TABS */
.topbar-tabs{display:flex;height:100%;gap:4px;overflow-x:auto;}
.topbar-tabs::-webkit-scrollbar{display:none;}
.ttab{background:none;border:none;color:rgba(255,255,255,.6);font-size:12px;font-weight:600;padding:0 14px;cursor:pointer;border-bottom:3px solid transparent;transition:all .15s;white-space:nowrap;}
.ttab:hover{color:#fff;}
.ttab.on{color:var(--gold);border-bottom-color:var(--gold);}
.panel{display:none; padding:24px; max-width:1400px; margin:0 auto; animation:fadeIn 0.2s;}
.panel.on{display:block;}
@keyframes fadeIn{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}

/* UI COMPONENTS */
.card{background:#fff;border:1px solid var(--border);border-radius:12px;padding:24px;margin-bottom:20px}
.card-title{font-size:14px;font-weight:700;color:var(--dark);text-transform:uppercase;letter-spacing:1px;margin-bottom:16px;border-bottom:2px solid var(--bg);padding-bottom:8px;display:flex;justify-content:space-between;align-items:center;}
.act-btn{background:#fff;border:1.5px solid var(--border);color:var(--dark);padding:9px 16px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;transition:all .15s;display:inline-flex;align-items:center;justify-content:center;gap:6px;}
.act-btn:hover{border-color:var(--gold);color:var(--gold)}
.act-btn.primary{background:var(--gold);border-color:var(--gold);color:#fff}
.act-btn.primary:hover{background:#B8872A;transform:translateY(-1px)}
.act-btn.small{padding:5px 10px;font-size:11px}
.act-btn:disabled{opacity:0.5;cursor:not-allowed;}

/* KPIS */
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:15px;margin-bottom:20px;}
.kpi{background:var(--surface);border:1px solid var(--border);padding:20px;border-radius:12px;}
.kpi-label{font-size:10px;text-transform:uppercase;font-weight:700;letter-spacing:.05em;color:var(--muted);margin-bottom:6px;}
.kpi-value{font-size:28px;font-weight:800;color:var(--dark);}

/* FORMS */
.grid-form{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;align-items:end;}
.fld{margin-bottom:4px;}
.fld label{display:block;font-size:10px;font-weight:700;color:var(--muted);margin-bottom:6px;text-transform:uppercase;letter-spacing:0.5px;}
.fld input,.fld select,.fld textarea{width:100%;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:10px 14px;font-size:13px;color:var(--dark);font-weight:600;}
.fld textarea{resize:vertical;min-height:70px;}
.fld input:focus,.fld select:focus{border-color:var(--gold);background:#fff;}
.fld input[readonly]{opacity:0.7;cursor:not-allowed;}

/* TABLES */
.table-wrap{overflow-x:auto;background:#fff;border-radius:12px;border:1px solid var(--border);}
table.tbl{width:100%;border-collapse:collapse;min-width:700px;}
table.tbl th{background:var(--dark);color:var(--gold);font-size:10px;text-transform:uppercase;padding:12px 14px;text-align:left;letter-spacing:0.4px;white-space:nowrap;}
table.tbl td{padding:10px 14px;border-bottom:1px solid var(--border);font-size:13px;}
table.tbl tr:last-child td{border-bottom:none}
table.tbl tbody tr:nth-child(even){background:#FAFAF8}
table.tbl tbody tr:hover td{background:#FEF9EE}

/* MISC */
.search-bar{display:flex;gap:12px;margin-bottom:16px;background:#fff;padding:10px 12px;border-radius:12px;border:1px solid var(--border);align-items:center;flex-wrap:wrap}
.search-bar input{flex:1;border:none;background:transparent;font-size:14px;color:var(--dark);font-weight:500;}
.badge{padding:4px 10px;border-radius:20px;font-size:10px;font-weight:700;text-transform:uppercase;display:inline-block;white-space:nowrap;}
.badge-ok{background:#DCFCE7;color:#166534;border:1px solid #BBF7D0;}
.badge-warn{background:#FEF3E2;color:#B45309;border:1px solid #FDE68A;}
.badge-err{background:#FEF2F2;color:#991B1B;border:1px solid #FECACA;}
.badge-info{background:#DBEAFE;color:#1E40AF;border:1px solid #BFDBFE;}
.badge-neutral{background:#F3F4F6;color:#4B5563;border:1px solid #D1D5DB;}
.modal-bg{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:200;display:flex;align-items:center;justify-content:center;padding:16px;display:none}
.modal{background:#fff;border-radius:14px;padding:30px;width:100%;max-width:450px;box-shadow:0 24px 60px rgba(0,0,0,.2);}
.modo-edicion{background:#EFF6FF;border:1.5px solid #BFDBFE;padding:12px 16px;border-radius:8px;margin-bottom:15px;display:none;}

/* SUMMARY CARDS (Liq/Finiquitos) */
.resumen{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:15px;}
.resumen-card{background:#FAFAF8;padding:20px;border-radius:10px;border:1px dashed var(--border);}
.resumen-row{display:flex;justify-content:space-between;padding:5px 0;font-size:13px;color:var(--muted)}
.total{font-weight:800;font-size:18px;margin-top:14px;padding-top:14px;border-top:2px solid var(--border);display:flex;justify-content:space-between;color:var(--gold)}
</style>
</head>
<body>
<script>
(function(){
  var MODULE_KEY = 'rrhh';
  var SESSION_KEY = 'cimagen_session';
  var SESSION_TTL_MS = 24 * 60 * 60 * 1000;
  var sess = null;
  try { sess = JSON.parse(localStorage.getItem(SESSION_KEY)); } catch(e){}
  var valid = sess && sess.email && sess.ts && (Date.now() - sess.ts < SESSION_TTL_MS);
  var allowed = valid && (sess.isAdmin || (sess.modules && sess.modules.indexOf(MODULE_KEY) !== -1));
  if (!allowed) {
    window.location.replace('index.html');
  }
})();
</script>

<a href="index.html" style="position:fixed; top:14px; left:20px; background:#1C1917; color:#C8973A; padding:8px 14px; border-radius:6px; border:1px solid #C8973A; text-decoration:none; font-family:Arial, sans-serif; font-size:11px; font-weight:bold; box-shadow:0 4px 6px rgba(0,0,0,0.2); z-index:9999;">← Menú</a>

<div class="topbar">
  <div class="brand"><div class="brand-tag">Módulo Integrado</div><div class="brand-name">Recursos <span>Humanos</span></div></div>
  <div class="topbar-tabs">
    <button class="ttab on" onclick="showTab('trabajadores', this)">Trabajadores</button>
    <button class="ttab" onclick="showTab('documentos', this)">Documentos</button>
    <button class="ttab" onclick="showTab('asistencia', this)">Asistencia</button>
    <button class="ttab" onclick="showTab('vacaciones', this)">Vacaciones</button>
    <button class="ttab" onclick="showTab('liquidaciones', this)">Liquidaciones</button>
    <button class="ttab" onclick="showTab('finiquitos', this)">Finiquitos</button>
    <button class="ttab" onclick="showTab('previred', this)">Previred</button>
    <button class="ttab" onclick="showTab('libro', this)">Libro Rem.</button>
    <button class="ttab" onclick="showTab('reportes', this)">Reportes</button>
  </div>
</div>

<!-- ======================= TRABAJADORES ======================= -->
<div class="panel on" id="p-trabajadores">
  <div class="kpis">
    <div class="kpi"><div class="kpi-label">Activos</div><div class="kpi-value text-teal" id="kpi-trab-activos">0</div></div>
    <div class="kpi"><div class="kpi-label">Inactivos</div><div class="kpi-value text-muted" id="kpi-trab-inactivos">0</div></div>
    <div class="kpi"><div class="kpi-label">Áreas</div><div class="kpi-value" id="kpi-trab-areas">0</div></div>
    <div class="kpi"><div class="kpi-label">Cargos</div><div class="kpi-value" id="kpi-trab-cargos">0</div></div>
  </div>

  <div class="card">
    <div class="card-title">Ficha de Trabajador</div>
    <div id="modoEdicionTrab" class="modo-edicion"><strong>✏️ MODO EDICIÓN</strong><div id="nombreEditandoTrab" style="font-size:12px;font-weight:600"></div></div>
    <div class="grid-form">
      <div class="fld"><label>RUT</label><input id="trab-rut" placeholder="Ej: 12.345.678-9" oninput="formatRut(this)" onblur="validarRutUI(this)"><span id="estadoRut" style="display:block;margin-top:4px;font-size:10px;font-weight:700"></span></div>
      <div class="fld"><label>Nombres</label><input id="trab-nombres"></div>
      <div class="fld"><label>Apellidos</label><input id="trab-apellidos"></div>
      <div class="fld"><label>Cargo</label><input id="trab-cargo"></div>
      <div class="fld"><label>Área / Dpto</label><input id="trab-area"></div>
      <div class="fld"><label>Jefatura Directa</label><input id="trab-jefatura"></div>
      <div class="fld"><label>Teléfono</label><input id="trab-telefono"></div>
      <div class="fld"><label>Correo</label><input id="trab-email"></div>
      <div class="fld"><label>AFP</label><select id="trab-afp"><option value="MODELO">Modelo</option><option value="UNO">Uno</option><option value="PLANVITAL">Planvital</option><option value="HABITAT">Habitat</option><option value="CAPITAL">Capital</option><option value="CUPRUM">Cuprum</option><option value="PROVIDA">Provida</option></select></div>
      <div class="fld"><label>Fecha Ingreso</label><input type="date" id="trab-ingreso"></div>
      <div class="fld"><label>Sueldo Base ($)</label><input type="number" id="trab-sueldo"></div>
      <div class="fld"><label>Estado</label><select id="trab-estado"><option value="Activo">Activo</option><option value="Inactivo">Inactivo</option></select></div>
    </div>
    <div style="margin-top:16px;display:flex;gap:10px;">
      <button class="act-btn primary" onclick="guardarTrabajador()">Guardar Trabajador</button>
      <button class="act-btn" id="btnCancelarTrab" style="display:none" onclick="cancelarEdicionTrab()">Cancelar</button>
    </div>
  </div>

  <div class="card">
    <div class="card-title">Directorio</div>
    <div class="search-bar"><span>🔍</span><input id="buscarTrab" placeholder="Buscar por nombre, RUT o cargo..." oninput="renderTrabajadores()"></div>
    <div class="table-wrap">
      <table class="tbl">
        <thead><tr><th>RUT</th><th>Nombre Completo</th><th>Cargo</th><th>Área</th><th style="text-align:center">Estado</th><th style="text-align:right">Acciones</th></tr></thead>
        <tbody id="tablaTrab"></tbody>
      </table>
    </div>
  </div>
</div>

<!-- ======================= DOCUMENTOS ======================= -->
<div class="panel" id="p-documentos">
  <div class="kpis">
    <div class="kpi"><div class="kpi-label">Trabajadores con Docs</div><div class="kpi-value text-teal" id="kpi-doc-trab">0</div></div>
    <div class="kpi"><div class="kpi-label">Total Documentos</div><div class="kpi-value text-gold" id="kpi-doc-total">0</div></div>
  </div>
  <div class="card">
    <div class="card-title">Subir Documento</div>
    <div class="grid-form" style="grid-template-columns:1fr 1fr 1.5fr auto;">
      <div class="fld"><label>Trabajador</label><select class="sel-trabajadores" id="doc-trabajador"></select></div>
      <div class="fld"><label>Categoría</label><select id="doc-cat"><option value="Contrato">Contrato</option><option value="Anexo">Anexo</option><option value="Curriculum">Currículum</option><option value="Carnet">Carnet de Identidad</option><option value="AFP">Certificado AFP</option><option value="Salud">Certificado Salud</option><option value="Antecedentes">Antecedentes</option><option value="Liquidacion">Liquidación</option><option value="Finiquito">Finiquito</option><option value="Otro">Otro</option></select></div>
      <div class="fld"><label>Archivo (Max 1MB, PDF/JPG/PNG)</label><input type="file" id="doc-file" accept=".pdf,.png,.jpg,.jpeg" style="padding:7px;font-size:12px;font-weight:400"></div>
      <div class="fld"><button class="act-btn primary" id="btnDocSubir" style="height:41px" onclick="subirDocumento()">Subir</button></div>
    </div>
  </div>
  <div class="card">
    <div class="card-title">Gestor Documental</div>
    <div class="search-bar"><span>🔍</span><input id="buscarDoc" placeholder="Buscar por trabajador o categoría..." oninput="renderDocumentos()"></div>
    <div class="table-wrap">
      <table class="tbl">
        <thead><tr><th>Trabajador</th><th>Categoría</th><th>Archivo</th><th>Fecha</th><th style="text-align:right">Acciones</th></tr></thead>
        <tbody id="tablaDoc"></tbody>
      </table>
    </div>
  </div>
</div>

<!-- ======================= ASISTENCIA ======================= -->
<div class="panel" id="p-asistencia">
  <div class="kpis">
    <div class="kpi"><div class="kpi-label">Registros</div><div class="kpi-value text-teal" id="kpi-asis-reg">0</div></div>
    <div class="kpi"><div class="kpi-label">Horas Extras</div><div class="kpi-value text-blue" id="kpi-asis-extras">0</div></div>
    <div class="kpi"><div class="kpi-label">Atrasos</div><div class="kpi-value text-red" id="kpi-asis-atrasos">0</div></div>
  </div>
  <div class="card">
    <div class="card-title">Control de Asistencia</div>
    <div class="grid-form" style="grid-template-columns:1fr 1fr 1fr; border-bottom:1px dashed var(--border); padding-bottom:16px; margin-bottom:16px;">
      <div class="fld"><label>Trabajador</label><select class="sel-trabajadores" id="asis-trab"></select></div>
      <div class="fld"><label>Fecha</label><input type="date" id="asis-fecha"></div>
      <div class="fld"><label>Jornada / Turno</label><select id="asis-jornada"><option value="44">44 Horas</option><option value="PARTTIME">Part Time</option><option value="ART22">Artículo 22</option></select></div>
    </div>
    <div class="grid-form" style="grid-template-columns:1fr 1fr 1fr 1fr auto;">
      <div class="fld"><label>Entrada (09:00)</label><input type="time" id="asis-ent"></div>
      <div class="fld"><label>Inicio Colación</label><input type="time" id="asis-col-ent"></div>
      <div class="fld"><label>Fin Colación</label><input type="time" id="asis-col-sal"></div>
      <div class="fld"><label>Salida Fin</label><input type="time" id="asis-sal"></div>
      <div class="fld"><button class="act-btn primary" style="height:41px" onclick="guardarAsistencia()">Registrar</button></div>
    </div>
  </div>
  <div class="card">
    <div class="card-title">Historial de Asistencia</div>
    <div class="search-bar"><span>🔍</span><input id="buscarAsis" placeholder="Buscar trabajador..." oninput="renderAsistencia()"></div>
    <div class="table-wrap">
      <table class="tbl">
        <thead><tr><th>Trabajador</th><th>Fecha</th><th>Tiempos</th><th>Horas Bruto</th><th>Extras</th><th>Atraso</th><th style="text-align:right">Acciones</th></tr></thead>
        <tbody id="tablaAsis"></tbody>
      </table>
    </div>
  </div>
</div>

<!-- ======================= VACACIONES ======================= -->
<div class="panel" id="p-vacaciones">
  <div class="kpis">
    <div class="kpi"><div class="kpi-label">Pendientes</div><div class="kpi-value text-amber" id="kpi-vac-pend">0</div></div>
    <div class="kpi"><div class="kpi-label">Aprobadas</div><div class="kpi-value text-teal" id="kpi-vac-aprob">0</div></div>
    <div class="kpi"><div class="kpi-label">Rechazadas</div><div class="kpi-value text-red" id="kpi-vac-rech">0</div></div>
  </div>
  <div class="card">
    <div class="card-title">Solicitar Vacaciones</div>
    <div class="grid-form" style="grid-template-columns:1fr 1.5fr;">
      <div>
        <div class="fld"><label>Trabajador</label><select class="sel-trabajadores" id="vac-trab" onchange="previewVac()"></select></div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
          <div class="fld"><label>Desde</label><input type="date" id="vac-ini" onchange="previewVac()"></div>
          <div class="fld"><label>Hasta</label><input type="date" id="vac-fin" onchange="previewVac()"></div>
        </div>
        <div class="fld"><label>Motivo</label><input id="vac-motivo" placeholder="Opcional..."></div>
        <button class="act-btn primary" style="width:100%;margin-top:10px" onclick="solicitarVacaciones()">Registrar Solicitud</button>
      </div>
      <div class="resumen-card">
        <h3>Análisis de Solicitud</h3>
        <div class="resumen-row"><span>Días Base:</span><strong id="vac-r-base">15</strong></div>
        <div class="resumen-row"><span>Histórico Usado:</span><strong id="vac-r-usados">0</strong></div>
        <div class="resumen-row" style="color:var(--teal)"><span>Saldo Previo:</span><strong id="vac-r-saldo">0</strong></div>
        <div style="margin:10px 0;border-top:1px dashed var(--border)"></div>
        <div class="resumen-row"><span>Hábiles a Descontar:</span><strong id="vac-r-descontar" style="color:var(--amber)">0</strong></div>
        <div class="resumen-row"><span style="font-size:11px">Fines de Semana:</span><strong id="vac-r-finde" style="font-size:11px">0</strong></div>
        <div class="resumen-row"><span style="font-size:11px">Feriados Legales:</span><strong id="vac-r-feriados" style="font-size:11px">0</strong></div>
        <div class="total"><span>NUEVO SALDO:</span><span id="vac-r-final">0</span></div>
      </div>
    </div>
  </div>
  <div class="card">
    <div class="card-title">Gestión de Solicitudes</div>
    <div class="search-bar"><span>🔍</span><input id="buscarVac" placeholder="Buscar trabajador..." oninput="renderVacaciones()"></div>
    <div class="table-wrap">
      <table class="tbl">
        <thead><tr><th>Trabajador</th><th>Período</th><th>Días</th><th style="text-align:center">Estado</th><th style="text-align:right">Acciones</th></tr></thead>
        <tbody id="tablaVac"></tbody>
      </table>
    </div>
  </div>
</div>

<div class="modal-bg" id="modalRechazoVac">
  <div class="modal">
    <div class="card-title">Motivo de Rechazo</div>
    <div class="fld"><textarea id="motivoRechazoVac" placeholder="Razón del rechazo..."></textarea></div>
    <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:16px">
      <button class="act-btn" onclick="document.getElementById('modalRechazoVac').style.display='none'">Cancelar</button>
      <button class="act-btn primary" style="background:var(--red);border-color:var(--red)" onclick="confirmarRechazoVac()">Rechazar</button>
    </div>
  </div>
</div>

<!-- ======================= LIQUIDACIONES ======================= -->
<div class="panel" id="p-liquidaciones">
  <div class="kpis">
    <div class="kpi"><div class="kpi-label">Liquidaciones Mes Actual</div><div class="kpi-value text-teal" id="kpi-liq-mes">0</div></div>
    <div class="kpi"><div class="kpi-label">Costo Empresa (Hist)</div><div class="kpi-value text-gold" id="kpi-liq-costo">$0</div></div>
    <div class="kpi"><div class="kpi-label">Líquido Pagado (Hist)</div><div class="kpi-value text-blue" id="kpi-liq-pago">$0</div></div>
  </div>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;">
    <div class="card" style="margin-bottom:0">
      <div class="card-title">Generar Liquidación</div>
      <div class="grid-form" style="grid-template-columns:1fr;gap:10px;">
        <div style="display:grid;grid-template-columns:2fr 1fr;gap:12px;">
          <div class="fld"><label>Trabajador</label><select class="sel-trabajadores" id="liq-trab" onchange="resetLiqCalc()"></select></div>
          <div class="fld"><label>Período</label><input type="month" id="liq-periodo" onchange="resetLiqCalc()"></div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:10px;">
          <div class="fld"><label>Sueldo Base ($)</label><input type="number" id="liq-sb" placeholder="0" oninput="resetLiqCalc()"></div>
          <div class="fld"><label>Gratificación ($)</label><input type="number" id="liq-grat" placeholder="0" oninput="resetLiqCalc()"></div>
          <div class="fld"><label>Bonos ($)</label><input type="number" id="liq-bonos" placeholder="0" oninput="resetLiqCalc()"></div>
          <div class="fld"><label>Comisiones ($)</label><input type="number" id="liq-com" placeholder="0" oninput="resetLiqCalc()"></div>
          <div class="fld"><label>B. Colación ($)</label><input type="number" id="liq-col" placeholder="0" oninput="resetLiqCalc()"></div>
          <div class="fld"><label>B. Movilización ($)</label><input type="number" id="liq-mov" placeholder="0" oninput="resetLiqCalc()"></div>
        </div>
      </div>
      <button class="act-btn" style="width:100%;margin-top:20px;background:var(--dark);color:#fff" onclick="calcularLiq()">Calcular Totales</button>
    </div>
    <div class="card" style="margin-bottom:0;display:flex;flex-direction:column;">
