let trabEditId = null;
function formatRut(input) {
  let v = input.value.replace(/\./g,"").replace(/-/g,"").toUpperCase();
  if(v.length > 1) input.value = v.slice(0,-1).replace(/\B(?=(\d{3})+(?!\d))/g, ".") + "-" + v.slice(-1);
}
function validarRutUI(input) {
  const v = input.value.replace(/\./g,"").replace(/-/g,"").toUpperCase();
  const el = $("estadoRut");
  if(!v){ el.textContent = ""; return; }
  if(v.length < 2){ el.textContent = "RUT Inválido"; el.style.color = "var(--red)"; return; }
  const cuerpo = v.slice(0,-1); let suma = 0, mult = 2;
  for(let i=cuerpo.length-1; i>=0; i--){ suma += parseInt(cuerpo.charAt(i))*mult; mult = mult > 6 ? 2 : mult+1; }
  const r = 11 - (suma % 11);
  const dvCalculado = r === 11 ? "0" : r === 10 ? "K" : r.toString();
  if(dvCalculado === v.slice(-1)){ el.textContent = "✅ RUT Válido"; el.style.color = "var(--green)"; } else { el.textContent = "❌ RUT Inválido"; el.style.color = "var(--red)"; }
}
